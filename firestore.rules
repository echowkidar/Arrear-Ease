rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null && request.auth.token.email == 'amulivealigarh@gmail.com';
    }

    function isSignedIn() {
      return request.auth != null;
    }

    // Fields only the admin may set on a user profile (plan, credits, permissions).
    function protectedUserFields() {
      return ['subscriptionPlan', 'credits', 'planExpiresAt', 'allowBasicPayAutoFill'];
    }

    function changedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    // A user may only lower their own credits by exactly 1 (used when an AI audit runs).
    function isSingleCreditDeduction() {
      return changedKeys().hasOnly(['credits'])
        && resource.data.credits is number
        && resource.data.credits > 0
        && request.resource.data.credits == resource.data.credits - 1;
    }

    match /users/{userId} {
      allow read: if isAdmin() || (isSignedIn() && request.auth.uid == userId);
      allow create: if isAdmin()
        || (isSignedIn() && request.auth.uid == userId
            && !request.resource.data.keys().hasAny(protectedUserFields()));
      allow update: if isAdmin()
        || (isSignedIn() && request.auth.uid == userId
            && (!changedKeys().hasAny(protectedUserFields()) || isSingleCreditDeduction()));
      allow delete: if isAdmin();
    }

    match /savedStatements/{statementId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isAdmin() || (isSignedIn() && request.resource.data.userId == request.auth.uid);
      // Both the existing owner and the new data must belong to the caller.
      allow update: if isAdmin()
        || (isSignedIn()
            && resource.data.userId == request.auth.uid
            && request.resource.data.userId == request.auth.uid);
      allow delete: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
    }

    // Arrear Summaries: a user manages only their own; the admin manages all.
    match /arrearSummaries/{summaryId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.ownerId == request.auth.uid);
      allow create: if isAdmin() || (isSignedIn() && request.resource.data.ownerId == request.auth.uid);
      allow update: if isAdmin()
        || (isSignedIn()
            && resource.data.ownerId == request.auth.uid
            && request.resource.data.ownerId == request.auth.uid);
      allow delete: if isAdmin() || (isSignedIn() && resource.data.ownerId == request.auth.uid);
    }

    match /configurations/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /payment_transactions/{txId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      // Users can only submit their own request, and it always starts as "pending".
      allow create: if isAdmin()
        || (isSignedIn()
            && request.resource.data.userId == request.auth.uid
            && request.resource.data.status == 'pending'
            && request.resource.data.planId in ['single', 'pro', 'unlimited']
            && request.resource.data.utr is string
            && request.resource.data.utr.size() > 0
            && request.resource.data.utr.size() <= 200);
      allow update, delete: if isAdmin();
    }
  }
}
